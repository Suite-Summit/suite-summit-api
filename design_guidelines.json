  "universal_guidelines": [
    "DO NOT use generic 'Inter' for headings. Use 'Manrope'.",
    "DO NOT use full-screen gradients. Use white/slate backgrounds with subtle accent touches.",
    "DO NOT center text by default. Left-align for readability.",
    "Use 2x more padding than you think is necessary. 'p-8' is the new 'p-4'.",
    "All interactive elements must have a hover state that changes color or lifts the element.",
    "Use 'sonner' for all toast notifications.",
    "Use 'lucide-react' for icons.",
    "Ensure all interactive elements have 'data-testid' attributes."
  ],
  "implementation_steps": [
    "1. Setup Tailwind config with new colors and fonts.",
    "2. Create reusable UI components (Button, Card, Input) in /components/ui.",
    "3. Build the Landing Page using the 'Tetris Grid'.",
    "4. Build the Auth Pages (Login/Register).",
    "5. Build the Company Intake Wizard.",
    "6. Build the Dashboard Layout (Sidebar + Header).",
    "7. Build the 'Summit View' AI Page.",
    "8. Build the Executive Matching Cards."
  ]
}