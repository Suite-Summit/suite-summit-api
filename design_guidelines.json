{
  "brand_identity": {
    "name": "Suite Summit",
    "tagline": "The Peak of Executive Matching",
    "tone": "Calm, Intelligent, Trustworthy, Premium, Effortless",
    "visual_theme": "Abstract Snowy Summit",
    "core_values": [
      "Precision",
      "Exclusivity",
      "Clarity"
    ]
  },
  "design_system": {
    "colors": {
      "primary": {
        "name": "Summit Charcoal",
        "hex": "#0f172a",
        "tailwind": "slate-900",
        "usage": "Headings, Primary Buttons, Footer Background"
      },
      "secondary": {
        "name": "Glacier White",
        "hex": "#ffffff",
        "tailwind": "white",
        "usage": "Card Backgrounds, Main Content Area"
      },
      "accent": {
        "name": "Ice Blue",
        "hex": "#38bdf8",
        "tailwind": "sky-400",
        "usage": "Primary CTAs, Active States, Highlights, Summit Line Gradient"
      },
      "neutral": {
        "name": "Slate Mist",
        "hex": "#f8fafc",
        "tailwind": "slate-50",
        "usage": "Page Backgrounds (Light Mode)"
      },
      "text": {
        "primary": "#0f172a",
        "secondary": "#475569",
        "tertiary": "#94a3b8"
      },
      "gradients": {
        "summit_fade": "linear-gradient(180deg, rgba(255,255,255,0) 0%, #f8fafc 100%)",
        "ice_glow": "linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%)"
      }
    },
    "typography": {
      "headings": {
        "family": "Manrope, sans-serif",
        "weights": [
          600,
          700,
          800
        ],
        "tracking": "-0.02em",
        "usage": "All H1-H6 elements. DISTINCT from body text."
      },
      "body": {
        "family": "Inter, sans-serif",
        "weights": [
          400,
          500
        ],
        "usage": "Paragraphs, Inputs, Labels, Data Tables"
      },
      "mono": {
        "family": "JetBrains Mono, monospace",
        "usage": "Financial Data, API Keys, IDs"
      }
    },
    "spacing": {
      "base_scale": "4px",
      "container_padding": "p-6 md:p-12 lg:p-24",
      "section_gap": "gap-16 md:gap-32",
      "component_gap": "gap-4 md:gap-8"
    },
    "borders": {
      "radius": {
        "sm": "2px",
        "md": "4px",
        "lg": "8px",
        "xl": "12px",
        "full": "9999px"
      },
      "width": "1px",
      "color": "border-slate-200"
    },
    "shadows": {
      "card": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "hover": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "glow": "0 0 20px -5px rgba(56, 189, 248, 0.3)"
    }
  },
  "layout_strategies": {
    "marketing_grid": {
      "name": "The Tetris Grid",
      "description": "Asymmetric grid for landing pages. Never equal columns.",
      "classes": "grid grid-cols-1 md:grid-cols-12 gap-8",
      "patterns": [
        "Hero: col-span-12 md:col-span-8 + col-span-12 md:col-span-4",
        "Feature: col-span-12 md:col-span-5 + col-span-12 md:col-span-7"
      ]
    },
    "dashboard_grid": {
      "name": "The Bento Grid",
      "description": "Dense, data-heavy grid for app views.",
      "classes": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4",
      "patterns": [
        "Main Chart: col-span-2 row-span-2",
        "Stat Card: col-span-1",
        "List Feed: col-span-1 row-span-2"
      ]
    }
  },
  "components": {
    "buttons": {
      "primary": "bg-slate-900 text-white hover:bg-slate-800 rounded-lg px-6 py-3 font-medium transition-all shadow-sm hover:shadow-md",
      "secondary": "bg-white text-slate-900 border border-slate-200 hover:bg-slate-50 rounded-lg px-6 py-3 font-medium transition-all",
      "ghost": "text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg px-4 py-2 transition-all"
    },
    "cards": {
      "base": "bg-white border border-slate-100 rounded-xl shadow-card p-6 hover:border-slate-200 transition-colors",
      "interactive": "cursor-pointer hover:shadow-hover hover:-translate-y-1 transition-all duration-300"
    },
    "inputs": {
      "base": "bg-white border border-slate-200 rounded-lg px-4 py-2 focus:ring-2 focus:ring-slate-900 focus:border-transparent outline-none transition-all placeholder:text-slate-400"
    }
  },
